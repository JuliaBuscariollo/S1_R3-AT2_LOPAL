    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;digite um n&#250;mero:&quot;" newline="True"/>
            <input variable="numero"/>
            <if expression="numero%5=0">
                <then>
                    <output expression="&quot;o numero &quot;&amp;numero&amp;&quot; &#233; multiplo de cinco!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot; o numero &quot;&amp;numero&amp;&quot; n&#227;o &#233; multiplico de cinco!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
