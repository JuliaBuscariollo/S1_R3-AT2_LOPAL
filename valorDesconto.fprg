<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="valorDesconto"/>
        <attribute name="authors" value="DES-I1HSB"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-04-08 01:43:50 "/>
        <attribute name="created" value="REVTLUkxSFNCO0VTTjUxMk4xMjYyODMxOzIwMjUtMDQtMDg7IjAxOjMwOjEyICI7MjYxMA=="/>
        <attribute name="edited" value="REVTLUkxSFNCO0VTTjUxMk4xMjYyODMxOzIwMjUtMDQtMDg7IjAxOjQzOjUwICI7MTsyNzI0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="compra, valorDesconto" type="Integer" array="False" size=""/>
            <output expression="&quot;insira o valor da compra:&quot;" newline="True"/>
            <input variable="compra"/>
            <if expression="compra&gt;=100">
                <then>
                    <assign variable="valorDesconto" expression="compra - compra*0.10"/>
                    <output expression="&quot;a compra ficou com um total de &quot;&amp;compra&amp;&quot;, por&#233;m, um desconto foi aplicado e voc&#234; ir&#225; pagar apenas &quot;&amp;valorDesconto&amp;&quot; !&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;o valor da compra &#233; &quot;&amp;compra&amp;&quot; !&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
