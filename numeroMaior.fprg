    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Real" array="False" size=""/>
            <output expression="&quot;digite um n&#250;mero maior que zero:&quot;" newline="True"/>
            <input variable="numero"/>
            <if expression="numero&gt;0">
                <then>
                    <output expression="&quot;este n&#250;mero &#233; maior que zero!&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="numero==0">
                        <then>
                            <output expression="&quot;este numero &#233; igual &#225; zero!&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;esse n&#250;mero &#233; menor que zero!&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
